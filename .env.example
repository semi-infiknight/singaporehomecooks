# === Client apps (Railway only — auto-written by pnpm install / pnpm env:sync) ===
# Source of truth: config/railway-client.json
EXPO_PUBLIC_MEDUSA_BASE=https://medusa-production-d2ba.up.railway.app
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_from_config_or_bootstrap
NEXT_PUBLIC_SHC_API_BASE=https://medusa-production-d2ba.up.railway.app
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_from_config_or_bootstrap

# Local Medusa (localhost:9000) is NOT supported for client development.

# === Medusa server secrets (Railway dashboard only — never commit) ===
# DATABASE_URL, REDIS_URL, JWT_SECRET, COOKIE_SECRET
# MEDUSA_PUBLIC_URL, STORE_CORS, AUTH_CORS, RAILWAY_RUN_SEED

# === Auth (production) ===
# SHC_STRICT_PASSWORD=1          # default strict when NODE_ENV=production (8+ chars, letter+number)
# SHC_ALLOW_DEMO_EMAILS=1        # allow @shc.local registration (staging only)
# SHC_COOK_ALLOW_DEV_PLAINTEXT=false  # disable dev cook plaintext login fallback
# SHC_DEV_COOK_CREDENTIALS_JSON= # optional JSON for local/staging demo cook logins (server only)

# === Optional ===
MAESTRO_CLOUD_TOKEN=

# === Medusa AI listing photos (Railway medusa only — never commit tokens) ===
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=   # Workers AI Run permission
# SHC_AI_IMAGE_MAX_PX=640
# SHC_AI_IMAGE_PER_COOK_HOUR=30
