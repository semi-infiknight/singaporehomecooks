# Medusa admin customizations (pnpm): hoist shared React libs so extensions
# share one instance with @medusajs/dashboard — avoids QueryClient / Router crashes.
# https://docs.medusajs.com/learn/configurations/pnpm
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
# Expo EAS + pnpm monorepo: hoist deps so Metro/babel can resolve expo/react-native packages.
public-hoist-pattern[]=metro-runtime
public-hoist-pattern[]=metro
node-linker=hoisted
# EAS pnpm install can OOM during lockfile resolution; frozen install + extra heap avoids SIGABRT.
node-options=--max-old-space-size=8192
