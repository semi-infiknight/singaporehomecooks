{
  "name": "singapore-home-cooks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:sync": "node scripts/sync-railway-env.mjs",
    "bootstrap:medusa": "node scripts/bootstrap-medusa.js",
    "verify:real-e2e": "npx tsx scripts/verify-real-e2e.ts",
    "smoke:tiffin": "npx tsx scripts/smoke-tiffin-routes.ts",
    "e2e:tiffin": "bash scripts/run-tiffin-e2e.sh",
    "verify:cook-wiring": "npx tsx scripts/verify-cook-customer-wiring.ts",
    "verify:wip": "bash scripts/verify-tier.sh wip",
    "verify:quick": "bash scripts/verify-tier.sh quick",
    "verify:goal": "bash scripts/verify-tier.sh goal",
    "verify:full": "bash scripts/verify-tier.sh full",
    "eas:setup": "bash scripts/eas-setup.sh",
    "maestro:validate": "bash scripts/maestro-validate.sh",
    "medusa:start": "cd apps/medusa && MEDUSA_DISABLE_ADMIN=true pnpm exec medusa start",
    "medusa:migrate": "cd apps/medusa && pnpm exec medusa db:migrate",
    "medusa:dev": "turbo dev --filter=medusa",
    "medusa:dev:admin": "cd apps/medusa && pnpm dev:admin",
    "medusa:build": "turbo build --filter=medusa",
    "verify:phase0": "pnpm turbo build && pnpm turbo test && pnpm turbo typecheck && pnpm turbo lint && echo 'Phase 0 verification passed'",
    "seed:medusa": "cd apps/medusa && pnpm seed || echo 'run bootstrap first'",
    "verify:local": "echo '=== Seed validate ===' && npx tsx scripts/seed.ts --validate && echo '=== Typecheck ===' && pnpm --filter mobile-customer typecheck && pnpm --filter mobile-cook typecheck && pnpm --filter web typecheck && echo '=== verify:local PASSED ==='",
    "verify:mobile-deps": "bash scripts/verify-mobile-deps.sh",
    "verify:mobile-bundles": "bash scripts/verify-mobile-bundles.sh",
    "verify:web-pwa": "bash scripts/verify-web-pwa.sh",
    "setup:ios-dev": "bash scripts/setup-ios-dev.sh",
    "dev:full": "pnpm env:sync && echo 'Start: bash scripts/start-mobile-dev.sh && pnpm web:dev  (all clients use Railway Medusa)'",
    "medusa:seed:validate": "cd apps/medusa && npx tsx scripts/seed.ts || true",
    "eas:customer:preview": "pnpm --filter mobile-customer eas:build:preview",
    "eas:cook:preview": "pnpm --filter mobile-cook eas:build:preview",

    "start:full": "echo 'See LOCAL_TESTING.md and the instructions below. Run in separate terminals.'",
    "customer:dev": "pnpm --filter mobile-customer start",
    "cook:dev": "pnpm --filter mobile-cook start",
    "customer:metro": "cd apps/mobile-customer && npx expo start --port 8081",
    "cook:metro": "cd apps/mobile-cook && RCT_METRO_PORT=8082 npx expo start --port 8082",
    "cook:reload": "bash scripts/reload-cook-emulator.sh",
    "maestro:full-tour": "bash scripts/run-maestro-full-tour.sh",
    "web:dev": "turbo dev --filter=web",
    "web:build": "turbo build --filter=web",
    "web:typecheck": "turbo typecheck --filter=web",
    "railway:init": "bash scripts/railway-init.sh",
    "railway:bootstrap": "node scripts/bootstrap-medusa.js",
    "railway:configure-web": "node scripts/railway-configure-web.mjs",
    "railway:configure-worker": "node scripts/railway-configure-service.mjs --service worker --config railway.worker.toml --dockerfile apps/worker/Dockerfile --health /health",
    "railway:configure-minio": "node scripts/railway-configure-service.mjs --service minio --config railway.minio.toml --dockerfile apps/minio/Dockerfile --no-redeploy",
    "railway:wire": "node scripts/railway-wire-references.mjs",
    "railway:cleanup": "node scripts/railway-cleanup.mjs",
    "railway:ship": "bash scripts/railway-ship-pwa.sh",
    "railway:verify-pwa": "bash scripts/railway-verify-pwa-evidence.sh",
    "postinstall": "node scripts/sync-railway-env.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.5.0",
    "nativewind": "^4.2.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.15.7",
    "turbo": "^2.9.18",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
